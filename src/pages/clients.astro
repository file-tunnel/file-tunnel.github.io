---
import SiteLayout from "../layouts/SiteLayout.astro";
const samples=[
 {id:"typescript",label:"TypeScript",file:"picker.ts",code:`import { FileTunnelClient } from "@file-tunnel/client";

const tunnel = await FileTunnelClient.createTunnel({
  applicationId: "receipts-web",
  accept: ["image/*", "application/pdf"],
});

picker.showRemote({
  pairingUri: tunnel.pairingUri,
  events: tunnel.events(),
});`,note:"The TypeScript client creates an ephemeral capability and streams ticket events without persisting the bearer credential."},
 {id:"rust",label:"Rust",file:"receive.rs",code:`let client = FileTunnelClient::new(
    "https://api.file-tunnel.example",
    token,
)?;

let tunnel = client.create_tunnel(CreateTunnel {
    application_id: "receipts-desktop".into(),
    accept: vec!["image/*".into(), "application/pdf".into()],
}).await?;

let mut events = client.events(&tunnel).await?;`,note:"The Rust package covers tunnel creation, pairing, declarations, upload/download, realtime tickets, and cancellation."},
 {id:"dart",label:"Dart / Flutter",file:"receive.dart",code:`final client = FileTunnelClient(
  baseUrl: 'https://api.file-tunnel.example',
  token: token,
);

final tunnel = await client.createTunnel(
  applicationId: 'receipts-mobile',
  accept: const ['image/*', 'application/pdf'],
);

await for (final event in client.events(tunnel)) {
  handle(event);
}`,note:"The Dart package gives Flutter hosts the same capability lifecycle and event contract."},
 {id:"gleam",label:"Gleam",file:"receive.gleam",code:`let assert Ok(client) =
  file_tunnel.new("https://api.file-tunnel.example", token)

let assert Ok(tunnel) =
  file_tunnel.create_tunnel(
    client,
    application_id: "receipts-beam",
    accept: ["image/*", "application/pdf"],
  )

file_tunnel.pairing_uri(tunnel)`,note:"The Gleam client brings the same typed operations to BEAM applications."},
];
---
<SiteLayout title="File Tunnel clients — TypeScript, Rust, Dart, and Gleam" description="Official File Tunnel SDK examples for capability-safe remote file intake.">
  <section class="clients-hero">
    <p class="kicker">ftnl-clients · polyglot SDKs</p>
    <h1>Accept a file from another device in the language already in your app.</h1>
    <p>TypeScript, Rust, Dart, and Gleam clients wrap the same short-lived capability model: create a tunnel, pair once, declare bytes, transfer, observe tickets, and cancel when the intent is gone.</p>
    <div class="rules"><span>Capabilities are not persisted</span><span>Uploads use declared objects</span><span>Realtime reports state, not authority</span></div>
  </section>

  <section class="client-grid" data-client-grid>
    <div class="explain">
      <p class="kicker">Choose a runtime</p>
      <h2>One transport contract, four maintained packages.</h2>
      <p>The SDKs keep authentication at the transport edge and expose the same tunnel lifecycle without inventing runtime-specific policy.</p>
      <a href="https://github.com/file-tunnel/ftnl-clients">Open ftnl-clients ↗</a>
    </div>
    <div class="workbench">
      <div class="toolbar">
        <label><span>Language</span><select aria-label="Select client language" data-language>{samples.map((sample,index)=><option value={sample.id} selected={index===0}>{sample.label}</option>)}</select></label>
        <code data-filename>{samples[0].file}</code><button type="button" data-copy>Copy</button>
      </div>
      {samples.map((sample,index)=><article data-sample={sample.id} data-file={sample.file} hidden={index!==0}><pre tabindex="0"><code>{sample.code}</code></pre><p>{sample.note}</p></article>)}
    </div>
  </section>

  <section class="lifecycle">
    <p class="kicker">The capability lifecycle</p><h2>Short-lived authority, explicit transfer state.</h2>
    <div><span>create tunnel</span><b>→</b><span>pair once</span><b>→</b><span>declare object</span><b>→</b><span>transfer bytes</span><b>→</b><span>consume or cancel</span></div>
    <p>File bytes and bearer capabilities stay outside Opto Sync. Only safe references, progress, and user-visible state cross synchronization boundaries.</p>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-client-grid]').forEach((root)=>{const select=root.querySelector('[data-language]');const filename=root.querySelector('[data-filename]');const copy=root.querySelector('[data-copy]');const panels=[...root.querySelectorAll('[data-sample]')];const show=(id)=>panels.forEach((panel)=>{const active=panel.dataset.sample===id;panel.hidden=!active;if(active)filename.textContent=panel.dataset.file||''});select?.addEventListener('change',(event)=>show(event.target.value));copy?.addEventListener('click',async()=>{const active=panels.find((panel)=>!panel.hidden);const text=active?.querySelector('code')?.textContent||'';try{await navigator.clipboard.writeText(text);copy.textContent='Copied'}catch{active?.querySelector('pre')?.focus();copy.textContent='Select code'}setTimeout(()=>copy.textContent='Copy',1200)})});
  </script>
</SiteLayout>

<style>
.clients-hero{padding:clamp(5rem,12vw,10rem) 0 4rem}.kicker{margin:0;color:#f6b73c;font:800 .72rem/1 ui-monospace,monospace;letter-spacing:.16em;text-transform:uppercase}.clients-hero h1{max-width:15ch;margin:.8rem 0 1.2rem;font-size:clamp(3rem,8vw,6.8rem);line-height:.88;letter-spacing:-.075em}.clients-hero>p:not(.kicker){max-width:50rem;color:#aab4c6;font-size:1.12rem}.rules{display:flex;gap:.7rem;flex-wrap:wrap;margin-top:2rem}.rules span{padding:.55rem .7rem;border:1px solid #ffffff1f;border-radius:999px;background:#ffffff0a;color:#cbd5e1;font-size:.76rem}.client-grid{display:grid;grid-template-columns:minmax(0,.75fr) minmax(31rem,1.25fr);gap:clamp(2rem,7vw,6rem);align-items:center;margin:4rem 0 9rem}.explain h2,.lifecycle h2{margin:.55rem 0 1rem;font-size:clamp(2.3rem,6vw,4.8rem);line-height:.94;letter-spacing:-.06em}.explain>p:not(.kicker),.lifecycle>p:last-child{color:#aab4c6}.explain a{display:inline-block;margin-top:1.2rem;color:#f6b73c;font-weight:800;text-decoration:none}.workbench{overflow:hidden;border:1px solid #ffffff24;border-radius:1.35rem;background:#07101e;box-shadow:0 34px 100px #0008}.toolbar{display:flex;gap:.8rem;align-items:end;padding:.9rem 1rem;border-bottom:1px solid #ffffff17;background:#0e1829}.toolbar label{display:grid;gap:.25rem}.toolbar label span{color:#94a3b8;font:700 .62rem/1 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}.toolbar select,.toolbar button{border:1px solid #ffffff28;border-radius:.6rem;background:#131f32;color:white;padding:.5rem .65rem;font:inherit}.toolbar button{margin-left:auto;cursor:pointer}.toolbar>code{align-self:center;color:#94a3b8;font-size:.76rem}.workbench pre{overflow:auto;min-height:23rem;max-height:31rem;margin:0;padding:1.3rem;color:#dbeafe;font:500 .84rem/1.72 ui-monospace,monospace;white-space:pre}.workbench article>p{margin:0;padding:.8rem 1.3rem 1rem;border-top:1px solid #ffffff15;color:#94a3b8;font-size:.8rem}.lifecycle{margin:0 0 8rem;padding:clamp(2rem,6vw,5rem);border:1px solid #ffffff1f;border-radius:1.6rem;background:linear-gradient(135deg,#141b28,#0b1018)}.lifecycle>div{display:flex;gap:.55rem;align-items:center;flex-wrap:wrap;margin:2rem 0}.lifecycle span{padding:.65rem .8rem;border:1px solid #ffffff20;border-radius:.65rem;background:#ffffff0a;font:650 .76rem/1 ui-monospace,monospace}.lifecycle b{color:#f6b73c}@media(max-width:900px){.client-grid{grid-template-columns:1fr}}@media(max-width:560px){.toolbar{align-items:stretch;flex-wrap:wrap}.toolbar>code{width:100%;order:3}.workbench pre{font-size:.76rem}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
